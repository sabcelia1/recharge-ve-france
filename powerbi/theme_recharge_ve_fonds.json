            "titleColor": {
              "solid": {
                "color": "#5B6676"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#5B6676"
              }
            },
            "position": "Top"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#EEF2F6"
              }
            },
            "transparency": 0
          }
