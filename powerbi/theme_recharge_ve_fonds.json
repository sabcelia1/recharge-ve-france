{
  "name": "Recharge VE France (fonds de page)",
  "dataColors": [
    "#0E9F8E",
    "#14213D",
    "#F2A541",
    "#7A8CA5",
    "#4FC3B5",
    "#E07A5F",
    "#3D5A80",
    "#B8C4D3"
  ],
  "foreground": "#14213D",
  "foregroundNeutralSecondary": "#5B6676",
  "foregroundNeutralTertiary": "#9AA5B4",
  "background": "#FFFFFF",
  "backgroundLight": "#EEF2F6",
  "backgroundNeutral": "#DDE3EA",
  "tableAccent": "#0E9F8E",
  "good": "#0E9F8E",
  "neutral": "#F2A541",
  "bad": "#D1495B",
  "maximum": "#0B7A6E",
  "center": "#A7DCD5",
  "minimum": "#F4F7F9",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#14213D"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#14213D"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#14213D"
