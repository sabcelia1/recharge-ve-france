table fct_point_recharge
	lineageTag: f3615f2e-f4e2-419b-a279-675f4412f4ab

	measure 'Nb points' = COUNTROWS(fct_point_recharge)
		formatString: 0
		lineageTag: 2351c683-3668-44af-9901-93d9db87e440

	measure 'Nb points rapides' = CALCULATE([Nb points], dim_palier_puissance[est_recharge_rapide] = TRUE())
		formatString: 0
		lineageTag: 6ef6048c-fc20-4f4e-9443-b9dd058e9f91

	measure '% recharge rapide' = DIVIDE([Nb points rapides], [Nb points])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: e789baa1-aaff-4148-942f-9c52f84936bd

	measure 'Nb VE' =
			
			VAR derniere_date = MAX(fct_parc_vehicules[date_arrete])
			RETURN
			    CALCULATE(
			        SUM(fct_parc_vehicules[nb_vp_electriques]),
			        fct_parc_vehicules[date_arrete] = derniere_date
			    )
		formatString: 0
		lineageTag: 2506e559-8860-42bb-ae01-b996d567b66e

	measure Population = SUM(dim_commune[population])
		formatString: 0
		lineageTag: 6af182d9-ef3a-465d-812b-3b89748fa4a8

	measure 'VE par point' = DIVIDE([Nb VE], [Nb points])
		lineageTag: 358a1125-d027-4c44-aebf-3a0d8c1bd7f2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Points pour 10k hab' = DIVIDE([Nb points], [Population]) * 10000
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 76989140-2970-4703-a538-a282e7f98f66

